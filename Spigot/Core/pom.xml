<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>Spigot</artifactId>
        <groupId>me.mraxetv.beastlib</groupId>
        <version>1.7.4</version><!--Parent-->
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <artifactId>Core</artifactId>

    <properties>
        <beastlib.export.root>F:/McServers</beastlib.export.root>
        <beastlib.export.skip>false</beastlib.export.skip>
        <!-- Full dependency-containing JAR used to compile BeastLib consumer plugins. Never install this on a server. -->
        <beastlib.developer.shadedJar>${project.build.directory}/${project.build.finalName}-shaded.jar</beastlib.developer.shadedJar>
        <!-- Second full shaded output retained for local comparison and shade diagnostics only. -->
        <beastlib.diagnostic.shadedJar>${project.build.directory}/${project.build.finalName}-shaded2.jar</beastlib.diagnostic.shadedJar>
        <!-- Thin BeastLib plugin JAR copied to servers. Libby supplies its excluded libraries dynamically at runtime. -->
        <beastlib.runtime.exportJar>${project.build.directory}/${project.artifactId}-${project.version}-export.jar</beastlib.runtime.exportJar>
    </properties>


    <build>
        <plugins>

            <!-- Compile and package the original JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- Compiler configuration... -->
                </configuration>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>


            <!-- Builds the full developer artifacts and the thin live-server runtime artifact. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <shadedArtifactAttached>true</shadedArtifactAttached>
                    <!-- Default output is the full developer JAR containing relocated compile-time dependencies. -->
                    <outputFile>${beastlib.developer.shadedJar}</outputFile>
                    <relocations>
                        <!-- Shared relocation map. The runtime execution filters dynamic libraries before relocation. -->
                        <relocation>
                            <pattern>de.tr7zw.changeme.nbtapi</pattern>
                            <shadedPattern>me.mraxetv.beastlib.lib.nbtapi</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>de.tr7zw.annotations</pattern>
                            <shadedPattern>me.mraxetv.beastlib.lib.nbtapi.annotations</shadedPattern>
                        </relocation>

                        <relocation>
                            <pattern>org.json.simple</pattern>
                            <shadedPattern>me.mraxetv.beastlib.lib.json</shadedPattern>
                        </relocation>

                        <relocation>
                            <pattern>com.google.gson</pattern>
                            <shadedPattern>me.mraxetv.beastlib.lib.gson</shadedPattern>
                        </relocation>

                        <relocation>
                            <pattern>com.zaxxer.hikari</pattern>
                            <shadedPattern>me.mraxetv.beastlib.lib.hikari</shadedPattern>
                        </relocation>

                        <relocation>
                            <pattern>dev.triumphteam</pattern>
                            <shadedPattern>me.mraxetv.beastlib.lib.tgui</shadedPattern>
                        </relocation>

                        <relocation>
                            <pattern>com.cryptomorin.xseries</pattern>
                            <!-- Be sure to change the package below -->
                            <shadedPattern>me.mraxetv.beastlib.lib.xmaterials</shadedPattern>
                        </relocation>

                        <relocation>
                            <pattern>org.bstats</pattern>
                            <!-- Replace this with your package! -->
                            <shadedPattern>me.mraxetv.beastlib.lib.bstats</shadedPattern>
                        </relocation>

                        <relocation>
                            <pattern>net.kyori</pattern>
                            <!-- Replace this with your package! -->
                            <shadedPattern>me.mraxetv.beastlib.lib.kyori</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>com.alessiodp.libby</pattern>
                            <!-- Replace this with your package! -->
                            <shadedPattern>me.mraxetv.beastlib.lib.libby</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>dev.dejvokep.boostedyaml</pattern>
                            <!-- Replace this with your package! -->
                            <shadedPattern>me.mraxetv.beastlib.lib.boostedyaml</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>com.mongodb</pattern>
                            <shadedPattern>me.mraxetv.beastlib.lib.mongodb</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>org.bson</pattern>
                            <shadedPattern>me.mraxetv.beastlib.lib.bson</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>com.mysql</pattern>
                            <shadedPattern>me.mraxetv.beastlib.lib.mysql</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>com.google.protobuf</pattern>
                            <shadedPattern>me.mraxetv.beastlib.lib.protobuf</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>org.mariadb</pattern>
                            <shadedPattern>me.mraxetv.beastlib.lib.mariadb</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>org.h2</pattern>
                            <shadedPattern>me.mraxetv.beastlib.lib.h2</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>org.postgresql</pattern>
                            <shadedPattern>me.mraxetv.beastlib.lib.postgresql</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>org.checkerframework</pattern>
                            <shadedPattern>me.mraxetv.beastlib.lib.checkerframework</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>redis.clients.jedis</pattern>
                            <shadedPattern>me.mraxetv.beastlib.lib.jedis</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>org.apache.commons.pool2</pattern>
                            <shadedPattern>me.mraxetv.beastlib.lib.pool2</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>org.json</pattern>
                            <shadedPattern>me.mraxetv.beastlib.lib.jsonjava</shadedPattern>
                            <excludes>
                                <exclude>org.json.simple.**</exclude>
                            </excludes>
                        </relocation>

                    </relocations>
                    <filters>
                        <filter>
                            <artifact>dev.triumphteam:triumph-gui</artifact>
                            <excludes>
                                <!-- Build-generated overlays retain the legacy Player overloads. -->
                                <exclude>dev/triumphteam/gui/guis/BaseGui.class</exclude>
                                <exclude>dev/triumphteam/gui/guis/PaginatedGui.class</exclude>
                                <exclude>dev/triumphteam/gui/guis/ScrollingGui.class</exclude>
                                <exclude>dev/triumphteam/gui/guis/StorageGui.class</exclude>
                            </excludes>
                        </filter>
                    </filters>
                </configuration>
                <executions>
                    <execution>
                        <id>build-developer-shaded-jar</id>
                        <!--
                            Produces Core-${project.version}-shaded.jar with all relocated libraries.
                            BeastKits and other plugins compile against this file using classifier "shaded".
                            It is installed into the local Maven repository during the install phase below.
                            This is NOT the JAR that belongs in a Minecraft server's plugins directory.
                        -->
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>

                    <execution>
                        <id>build-diagnostic-full-shaded-jar</id>
                        <!--
                            Produces Core-${project.version}-shaded2.jar as a second full shaded output
                            for local shade comparison/debugging. It is neither installed nor copied to servers.
                        -->
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <outputFile>${beastlib.diagnostic.shadedJar}</outputFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>build-server-runtime-jar</id>
                        <!--
                            Produces Core-${project.version}-export.jar, the thin live BeastLib plugin.
                            This keeps BeastLib/Libby bootstrap code but removes libraries that BeastLib.java
                            downloads and relocates dynamically during startup. The filter paths below are the
                            dependencies' original paths because Maven filters them before applying relocation.
                        -->
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <filters combine.self="override">
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>org/sqlite/**</exclude>
                                        <exclude>com/cryptomorin/xseries/**</exclude>
                                        <exclude>com/zaxxer/**</exclude>
                                        <exclude>com/google/gson/**</exclude>
                                        <exclude>com/mongodb/**</exclude>
                                        <exclude>org/bson/**</exclude>
                                        <exclude>com/mysql/**</exclude>
                                        <exclude>com/google/protobuf/**</exclude>
                                        <exclude>org/mariadb/**</exclude>
                                        <exclude>org/h2/**</exclude>
                                        <exclude>org/postgresql/**</exclude>
                                        <exclude>org/checkerframework/**</exclude>
                                        <exclude>redis/clients/jedis/**</exclude>
                                        <exclude>org/apache/commons/pool2/**</exclude>
                                        <!-- JSON-java has classes directly in org/json; preserve org/json/simple. -->
                                        <exclude>org/json/*.class</exclude>
                                        <exclude>net/kyori/**</exclude>
                                        <exclude>org/intellij/**</exclude>
                                        <exclude>org/jetbrains/**</exclude>
                                        <exclude>org/slf4j/**</exclude>
                                        <exclude>dev/dejvokep/boostedyaml/**</exclude>
                                        <exclude>META-INF/**</exclude>
                                        <exclude>dev/triumphteam/**</exclude>
                                        <exclude>de/tr7zw/**</exclude>
                                        <exclude>jakarta/**</exclude>
                                        <exclude>checkstyle.xml</exclude>
                                    </excludes>
                                </filter>
                            </filters>

                            <finalName>${project.name}-${project.parent.version}</finalName>
                            <outputFile>${beastlib.runtime.exportJar}</outputFile>
                        </configuration>
                    </execution>


                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>3.1.1</version>
                <executions>
                    <execution>
                        <id>install-developer-shaded-jar-to-local-m2</id>
                        <!--
                            mvn install publishes only the full developer JAR as Core:${project.version}:shaded
                            in the local Maven repository so consumer plugins can compile against relocated APIs.
                        -->
                        <phase>install</phase>
                        <goals>
                            <goal>install-file</goal>
                        </goals>
                        <configuration>
                            <file>${beastlib.developer.shadedJar}</file>
                            <groupId>me.mraxetv.beastlib</groupId>
                            <artifactId>Core</artifactId>
                            <version>${project.version}</version>
                            <classifier>shaded</classifier>
                            <packaging>jar</packaging>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <dependencies>
                    <!-- Build tooling only; ASM is never added to the server JAR. -->
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm</artifactId>
                        <version>9.7.1</version>
                    </dependency>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm-commons</artifactId>
                        <version>9.7.1</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>restore-gui-player-overloads</id>
                        <phase>process-classes</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target name="restore-gui-player-overloads">
                                <mkdir dir="${project.build.directory}/gui-compat-tool"/>
                                <javac destdir="${project.build.directory}/gui-compat-tool" release="8"
                                       encoding="UTF-8" includeantruntime="false">
                                    <src path="${project.basedir}/src/build/java"/>
                                    <src path="${project.basedir}/src/build-test/java"/>
                                    <classpath refid="maven.plugin.classpath"/>
                                </javac>
                                <path id="gui.compat.classpath">
                                    <pathelement location="${project.build.directory}/gui-compat-tool"/>
                                    <path refid="maven.plugin.classpath"/>
                                    <path refid="maven.compile.classpath"/>
                                </path>
                                <java classname="me.mraxetv.beastlib.build.GuiCompatibilityPatcherTest" fork="true" failonerror="true">
                                    <classpath refid="gui.compat.classpath"/>
                                </java>
                                <java classname="me.mraxetv.beastlib.build.GuiCompatibilityPatcher" fork="true" failonerror="true">
                                    <classpath refid="gui.compat.classpath"/>
                                    <arg value="${project.build.outputDirectory}"/>
                                </java>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>export-plugin-jar</id>
                        <!--
                            Every normal mvn package overwrites BeastLib.jar in the development servers below
                            and archives the same thin runtime artifact in production/BeastLib.
                            Use -Dbeastlib.export.skip=true for isolated verification.
                            Neither full developer JAR is ever copied by this execution.
                        -->
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${beastlib.export.skip}</skip>
                            <target name="export-plugin-jar">
                                <copy file="${beastlib.runtime.exportJar}" tofile="${beastlib.export.root}/Console/servers/Paper_1.8/plugins/BeastLib.jar" overwrite="true" failonerror="true"/>
                                <copy file="${beastlib.runtime.exportJar}" tofile="${beastlib.export.root}/Console/servers/latests/plugins/BeastLib.jar" overwrite="true" failonerror="true"/>
                                <copy file="${beastlib.runtime.exportJar}" tofile="${beastlib.export.root}/Console/servers/BC 1/plugins/BeastLib.jar" overwrite="true" failonerror="true"/>
                                <copy file="${beastlib.runtime.exportJar}" tofile="${beastlib.export.root}/Console/servers/BC 2/plugins/BeastLib.jar" overwrite="true" failonerror="true"/>
                                <copy file="${beastlib.runtime.exportJar}" tofile="${beastlib.export.root}/Bungee/Valocity/s1/plugins/BeastLib.jar" overwrite="true" failonerror="true"/>
                                <copy file="${beastlib.runtime.exportJar}" tofile="${beastlib.export.root}/Bungee/Valocity/s2/plugins/BeastLib.jar" overwrite="true" failonerror="true"/>
                                <copy file="${beastlib.runtime.exportJar}" tofile="${beastlib.export.root}/production/BeastLib/BeastLib-${project.version}.jar" overwrite="true" failonerror="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>


        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <repositories>
